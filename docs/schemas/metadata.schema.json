{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metadata.schema.json",
  "title": "Fire Seasons metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "generated_utc": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "commit",
        "code_dirty",
        "generated_utc"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "iso_3166_2": {
            "type": [
              "string",
              "null"
            ]
          },
          "area_km2": {
            "type": "number"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "boundary_source": {
            "type": "string"
          }
        },
        "required": [
          "region_id",
          "name",
          "iso_3166_2",
          "area_km2",
          "bbox",
          "boundary_source"
        ],
        "additionalProperties": false
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sensor": {
            "type": "string"
          },
          "platforms": {
            "type": "array"
          },
          "product": {
            "type": "string"
          },
          "label_en": {
            "type": "string"
          },
          "label_es": {
            "type": "string"
          },
          "nominal_resolution_m": {
            "type": "integer"
          },
          "coverage": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },
          "collections_by_year": {
            "type": "object"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "sensor",
          "platforms",
          "product",
          "label_en",
          "label_es",
          "nominal_resolution_m",
          "coverage",
          "collections_by_year",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "methods": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "activity_classes": {
      "type": "object"
    },
    "weather_variables": {
      "type": "object"
    },
    "weather_years_exported": {
      "type": "array"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file"
        ]
      }
    },
    "exploratory_fire_weather_association": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "en": {
            "type": "string"
          },
          "es": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "en",
          "es"
        ],
        "additionalProperties": false
      }
    },
    "hotspot_properties": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "pipeline",
    "project",
    "regions",
    "series",
    "methods",
    "metrics",
    "activity_classes",
    "weather_variables",
    "weather_years_exported",
    "inputs",
    "exploratory_fire_weather_association",
    "limitations",
    "hotspot_properties",
    "files"
  ],
  "additionalProperties": false
}
