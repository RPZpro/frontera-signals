{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather.schema.json",
  "title": "Fire Seasons weather context",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string"
          },
          "variable": {
            "enum": [
              "T2M",
              "RH2M",
              "PRECTOTCORR",
              "WS10M"
            ]
          },
          "long_name": {
            "type": "string"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "period_type": {
            "const": "month"
          },
          "time_standard": {
            "const": "LST"
          },
          "source": {
            "type": "string"
          },
          "dataset": {
            "type": "string"
          },
          "native_resolution_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "unit": {
            "type": "string"
          },
          "kind": {
            "const": "derived"
          },
          "quality": {
            "enum": [
              "ok",
              "partial_coverage",
              "no_data",
              "qc_excluded"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "normal_period": {
            "type": "string"
          },
          "normal_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "anomaly": {
            "type": [
              "number",
              "null"
            ]
          },
          "anomaly_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "region_id",
          "variable",
          "long_name",
          "period",
          "period_type",
          "time_standard",
          "source",
          "dataset",
          "native_resolution_deg",
          "unit",
          "kind",
          "quality",
          "value",
          "normal_period",
          "normal_mean",
          "anomaly",
          "anomaly_pct"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
