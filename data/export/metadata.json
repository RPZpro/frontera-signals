  "limitations": [
    {
      "id": "raw_counts",
      "en": "Raw MODIS and VIIRS hotspot counts are not directly comparable: resolution, sensitivity, overpass time and confidence definitions differ. Compare percentiles.",
      "es": "Los conteos crudos de MODIS y VIIRS no son comparables directamente: difieren en resolución, sensibilidad, hora de paso y definición de confianza. Comparar percentiles."
    },
    {
      "id": "hotspot_not_fire",
      "en": "A hotspot is a hot pixel at overpass time, not an independent fire.",
      "es": "Un punto de calor es un pixel caliente al paso del satélite, no un incendio independiente."
    },
    {
      "id": "no_cause",
      "en": "A thermal anomaly does not indicate cause, intent or criminal activity.",
      "es": "Una anomalía térmica no indica causa, intención ni actividad criminal."
    },
    {
      "id": "absence",
      "en": "No detection does not prove absence of fire (clouds, timing, small fires).",
      "es": "Que no haya detección no prueba que no hubo fuego (nubes, horario, incendios pequeños)."
    },
    {
      "id": "short_record",
      "en": "Fire percentiles use only 6 years (each month vs 5 others): 'above_range' means highest in this record, not a rare event.",
      "es": "Los percentiles de fuego usan solo 6 años (cada mes contra otros 5): 'above_range' significa el más alto del registro, no un evento raro."
